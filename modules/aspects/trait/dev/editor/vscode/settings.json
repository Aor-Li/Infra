{
    // appearance：配色主题由 stylix 生成（扩展名 stylix.stylix），图标仍用 catppuccin
    "workbench.iconTheme": "catppuccin-mocha",
    "workbench.colorTheme": "Stylix",

    // 本体与 nix 声明的扩展由 nix 锁定版本，不让 VS Code 自己更新
    "update.mode": "none",
    "extensions.autoUpdate": false,
    "extensions.autoCheckUpdates": false,

    // terminal
    "terminal.integrated.stickyScroll.enabled": false, // for tmux

    // ssh：保持持续连接
    "terminal.integrated.enablePersistentSessions": true,
    "terminal.integrated.persistentSessionReviveProcess": true,
    
    // 集成浏览器
    "workbench.browser.enableRemoteProxy": true,
    "workbench.browser.dataStorage": "workspace",

    "claudeCode.preferredLocation": "panel",
    "git.openRepositoryInParentFolders": "never",
    "python.analysis.typeCheckingMode": "standard",
    "editor.unicodeHighlight.nonBasicASCII": false,
    "editor.fontFamily": "CaskaydiaCove Nerd Font, 等距更纱黑体 SC, Menlo, Monaco, 'Courier New', monospace",
    "git.confirmSync": false,
    
